# EmailJS public configuration for the Eid reservation form.
# These values are safe to expose in the browser, but keep any private API keys out of VITE_* variables.
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
